      "name": "First Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene al menos un usuario\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"El primer usuario tiene nombre y email\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData[0]).to.have.property(\"name\");\r",
              "    pm.expect(jsonData[0]).to.have.property(\"email\");\r",
              "});"
            ],
