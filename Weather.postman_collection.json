      "name": "Clima Varsovia",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene datos del clima actual\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"current_weather\");\r",
              "});\r",
              "\r",
              "pm.test(\"La temperatura es un número\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.current_weather.temperature).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"La latitud coincide con Varsovia (aprox)\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.latitude).to.be.closeTo(52.23, 0.5);\r",
              "});"
            ],
