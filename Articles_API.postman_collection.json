              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(pm.response.json()).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First article contains correct fields: id, user_id, title, body\", function () {\r",
                  "    pm.expect(pm.response.json()[0]).to.have.all.keys('id', 'user_id', 'title', 'body');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Article ID is a number\", function () {\r",
                  "    pm.expect(pm.response.json()[0].id).to.be.a('number');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
