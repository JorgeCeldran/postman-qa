        {
          "name": "Get_Users_By_Gender_And_Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All results match requested gender\", function () {\r",
                  "\tvar expectedGender = pm.request.url.query.get('gender');\r",
                  "\tvar jsonData = pm.response.json();\r",
                  "\tjsonData.forEach(function (user) {\r",
                  "\t\tpm.expect(user.gender).to.eql(expectedGender);\r",
                  "\t});\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains 10 results\", function () {\r",
                  "\tvar jsonData = pm.response.json();\r",
                  "\tpm.expect(jsonData.length).to.be.at.most(10);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All names actually start with the requested letter\", function () {\r",
                  "    var expectedLetter = pm.request.url.query.get('name');\r",
                  "    var jsonData = pm.response.json();\r",
                  "    jsonData.forEach(function (user) {\r",
                  "        pm.expect(user.name.toUpperCase().startsWith(expectedLetter.toUpperCase())).to.be.true;\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?gender={{gender}}&{{letter}}&{{length}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ],
