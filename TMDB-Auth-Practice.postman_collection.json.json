      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tmdb_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.themoviedb.org/3/movie/popular",
          "protocol": "https",
          "host": [
            "api",
            "themoviedb",
            "org"
