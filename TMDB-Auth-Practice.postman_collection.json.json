    {
      "name": "Popular Movies - API Key v3'",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"First movie has original_language field\", () => { \r",
              "    const originalLan = pm.response.json(); \r",
              "    pm.expect(originalLan.results[0]).to.have.property(\"original_language\"); \r",
              "});\r",
              "\r",
              "pm.test(\"All movies have property original_language\", function () {\r",
              "    const original_language_all = pm.response.json();\r",
              "    original_language_all.results.forEach(movie => {\r",
              "        pm.expect(movie).to.have.property(\"original_language\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"There are movies which original_language is Spanish\", function () {\r",
              "    const original_language_ES = pm.response.json();\r",
              "    const spanishMovies = original_language_ES.results.filter(movie => movie.original_language === \"es\");\r",
              "    console.log(\"Número de películas en español: \", spanishMovies.length);\r",
              "    pm.expect(spanishMovies.length).to.be.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.themoviedb.org/3/movie/popular?api_key={{tmdb_api_key}}",
          "protocol": "https",
          "host": [
            "api",
            "themoviedb",
            "org"
          ],
          "path": [
            "3",
            "movie",
            "popular"
          ],
          "query": [
            {
              "key": "api_key",
              "value": "{{tmdb_api_key}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
